<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>じゃんけん2</title>
</head>
<body>
    <h1>じゃんけん結果</h1>
    <p>あなたの手は<%= your %>です．</p>
    <p>コンピュータは<%= cpu %>です．</p>
    <p>判定：<%= judgement %></p>
    <p>現在<%= total %>試合中<%= win %>勝しています．</p>
    <hr>
    <form action="/janken2">
        <p>次は何を出す？</p>
        <input type="radio" name="hand" id="hand_gu" value="グー" checked>
        <label for="hand_gu">グー</label>

        <input type="radio" name="hand" id="hand_choki" value="チョキ">
        <label for="hand_choki">チョキ</label>

        <input type="radio" name="hand" id="hand_pa" value="パー">
        <label for="hand_pa">パー</label>
        <br><br>
        <input type="hidden" name="win" value="<%= win %>">
        <input type="hidden" name="total" value="<%= total %>">
        <input type="submit" value="じゃんけん　ポン">
    </form>   
</body>
</html>

